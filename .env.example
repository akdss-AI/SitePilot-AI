# Copy this file to .env and fill in your own values.
# NEVER commit a real .env file. NEVER put a real key in this example file.

APP_NAME=SitePilot AI
APP_ENV=development
DEBUG=true
APP_VERSION=0.1.0

# PostgreSQL in real use, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sitepilot
# SQLite is allowed only for quick local experiments / automated tests:
DATABASE_URL=sqlite:///./sitepilot_dev.db

# Used for JWT signing (Phase 2). Generate a long random value (32+ bytes
# for HS256) — a short key triggers security warnings and is weaker.
SECRET_KEY=change-me-in-your-real-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq (Phase 5). Leave empty until Phase 5 — the app runs without it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
